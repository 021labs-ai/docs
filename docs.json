{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "willow",
  "name": "RDK Python SDK",
  "colors": {
    "primary": "#1a1a1a",
    "light": "#444444",
    "dark": "#f5f5f4"
  },
  "appearance": {
    "default": "light"
  },
  "background": {
    "decoration": "none"
  },
  "codeBlock": {
    "theme": "dracula"
  },
  "rounded": "default",
  "favicon": "/favicon.svg",
  "navigation": {
    "tabs": [
      {
        "tab": "Documentation",
        "groups": [
          {
            "group": "Getting Started",
            "pages": [
              "introduction",
              "quickstart",
              "concepts"
            ]
          },
          {
            "group": "Integrations",
            "pages": [
              "integrations/anthropic",
              "integrations/openai",
              "integrations/langchain",
              "integrations/gemini",
              "integrations/baml"
            ]
          },
          {
            "group": "Guides",
            "pages": [
              "guides/fastapi",
              "guides/agent-tracing",
              "guides/testing"
            ]
          }
        ]
      },
      {
        "tab": "API Reference",
        "groups": [
          {
            "group": "Core",
            "pages": [
              "api-reference/init",
              "api-reference/observe",
              "api-reference/trace",
              "api-reference/span",
              "api-reference/flush",
              "api-reference/shutdown"
            ]
          },
          {
            "group": "Utilities",
            "pages": [
              "api-reference/get-current-trace",
              "api-reference/instrument-baml",
              "api-reference/mock-tools"
            ]
          },
          {
            "group": "PII Redaction",
            "pages": [
              "api-reference/redactor-config",
              "api-reference/create-redactor",
              "api-reference/redact-all-pii"
            ]
          },
          {
            "group": "Models",
            "pages": [
              "api-reference/models/trace",
              "api-reference/models/span",
              "api-reference/models/token-usage"
            ]
          }
        ]
      }
    ],
    "global": {
      "anchors": [
        {
          "anchor": "GitHub",
          "href": "https://github.com/021/rdk-python",
          "icon": "github"
        },
        {
          "anchor": "PyPI",
          "href": "https://pypi.org/project/rdk/",
          "icon": "python"
        }
      ]
    }
  },
  "logo": {
    "light": "/logo/light.svg",
    "dark": "/logo/dark.svg"
  },
  "navbar": {
    "links": [
      {
        "label": "Support",
        "href": "mailto:support@021labs.ai"
      }
    ],
    "primary": {
      "type": "button",
      "label": "Get Started",
      "href": "/quickstart"
    }
  },
  "contextual": {
    "options": [
      "copy",
      "view",
      "claude",
      "cursor",
      "vscode"
    ]
  },
  "footer": {
    "socials": {
      "github": "https://github.com/021/rdk-python"
    }
  }
}
